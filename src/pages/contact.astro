---
import Layout from '../layouts/Layout.astro';
import { site, contactHref } from '../config';
const subjects = [
  'General enquiry — FoundNexa',
  'Founder interest — FoundNexa',
  'Development project — FoundNexa',
  'Partnership conversation — FoundNexa',
];
---
<Layout title="Contact — FoundNexa" description="Contact FoundNexa about incubation, software development, or partnership opportunities.">
  <main id="main" class="container contact-page">
    <span class="eyebrow">Contact FoundNexa</span>
    <h1>Start a conversation.</h1>
    {site.email ? <>
      <p class="contact-page-intro">Email us about your venture, your next product, or a potential partnership.</p>
      <div class="contact-details" data-email={site.email} data-subjects={JSON.stringify(subjects)}>
        <span class="eyebrow">Our email address</span>
        <p class="contact-address"><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="contact-subject">Subject: <span data-contact-subject>{subjects[0]}</span></p>
        <div class="actions">
          <button type="button" class="button" data-copy-email hidden>Copy email address <span aria-hidden="true">⧉</span></button>
          <a class="text-link" data-email-app href={contactHref(subjects[0])}>Open email app <span aria-hidden="true">↗</span></a>
        </div>
        <p class="copy-status" role="status" aria-live="polite"></p>
        <p class="contact-page-help">You can also copy this address into Gmail, Outlook, or whichever email service you use. Nothing is sent through this page.</p>
      </div>
    </> : <p class="contact-page-intro">Our contact address is being finalized. Please check back.</p>}
    <a class="text-link" href="/">← Back to FoundNexa</a>
  </main>
</Layout>
<script>
  const details = document.querySelector<HTMLElement>('.contact-details');
  if (details) {
    const email = details.dataset.email!;
    const subjects: string[] = JSON.parse(details.dataset.subjects!);
    const requestedSubject = new URLSearchParams(window.location.search).get('subject');
    const subject = requestedSubject && subjects.includes(requestedSubject) ? requestedSubject : subjects[0];
    const subjectLabel = details.querySelector<HTMLElement>('[data-contact-subject]')!;
    const emailLink = details.querySelector<HTMLAnchorElement>('[data-email-app]')!;
    subjectLabel.textContent = subject;
    emailLink.href = `mailto:${email}?subject=${encodeURIComponent(subject)}`;
    const copyButton = details.querySelector<HTMLButtonElement>('[data-copy-email]')!;
    const status = details.querySelector<HTMLElement>('.copy-status')!;
    copyButton.hidden = false;
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        status.textContent = 'Email address copied. Paste it into your email service.';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(details.querySelector('.contact-address a')!);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        status.textContent = 'The email address is selected. Use your device’s copy command, then paste it into your email service.';
      }
    });
  }
</script>
<style>
  .contact-page { max-width: 900px; padding-block: 85px 110px; min-height: 65vh; }
  h1 { font-size: clamp(48px, 6vw, 76px); }
  .contact-page-intro { color: var(--muted); max-width: 570px; margin-top: 26px; }
  .contact-details { margin-block: 38px; border-block: 1px solid var(--line); padding-block: 32px; }
  .contact-details .eyebrow { margin-bottom: 12px; }
  .contact-address { font-size: clamp(24px, 4vw, 36px); letter-spacing: -.03em; overflow-wrap: anywhere; margin-bottom: 12px; }
  .contact-address a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .contact-subject { color: var(--muted); font-size: 13px; }
  .contact-page-help { font-size: 13px; color: var(--muted); max-width: 570px; margin-bottom: 0; }
  .copy-status { font-size: 13px; color: var(--blue); margin: 15px 0; }
  [hidden] { display: none; }
  @media(max-width: 760px) { .contact-page { padding-block: 55px 70px; } }
</style>
