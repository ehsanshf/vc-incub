---
import { site } from '../config';
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'FoundNexa — Build around a problem worth solving', description = site.description } = Astro.props;
const canonical = site.domain ? new URL(Astro.url.pathname, site.domain).href : undefined;
---
<!doctype html>
<html lang="en-CA">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title><meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:locale" content="en_CA" /><meta property="og:site_name" content={site.name} />
<meta property="og:image" content={site.domain ? `${site.domain}/social-card.png` : '/social-card.png'} />
{canonical && <meta property="og:url" content={canonical} />}<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#101f39" />
{!site.domain && <meta name="robots" content="noindex, nofollow" />}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="header"><div class="container header-inner">
<a href="/" class="brand" aria-label="FoundNexa home"><img src="/brand/foundnexa-mark.svg" width="38" height="38" alt="" class="brand-mark" /><span>Found<span class="brand-light">Nexa</span><span class="brand-dot">.</span></span></a>
<nav aria-label="Main navigation" class="desktop-nav">{site.navigation.map(([label, id]) => <a href={`/#${id}`}>{label}</a>)}</nav>
<details class="mobile-nav"><summary>Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile navigation">{site.navigation.map(([label, id]) => <a href={`/#${id}`}>{label}</a>)}</nav></details>
</div></header>
<slot />
<footer><div class="container footer-top"><a href="/" class="brand"><img src="/brand/foundnexa-mark.svg" width="38" height="38" alt="" class="brand-mark" />FoundNexa<span class="brand-dot">.</span></a><p>Good questions. Clear milestones.<br />Meaningful businesses.</p><div><span class="eyebrow">Based in Canada</span><p>{site.location}</p></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span><nav aria-label="Footer navigation"><a href="/#about">About</a><a href="/#program">Program</a><a href="/#contact">Contact</a><a href="/privacy/">Privacy</a></nav></div></footer>
<script>
 document.querySelectorAll('.mobile-nav a').forEach(link => link.addEventListener('click', () => document.querySelector('.mobile-nav')?.removeAttribute('open')));
</script>
</body></html>
